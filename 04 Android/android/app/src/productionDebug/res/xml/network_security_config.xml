<?xml version="1.0" encoding="utf-8"?>
<!-- W4-12: the APK talks to the hotel server only over HTTPS (cleartext refused) and trusts the system CAs plus the hotel CA
     (HCC-Hotel-CA.cer from deployment\windows\New-HccCertificate.ps1), copied to res/raw/hcc_hotel_ca.pem by
     scripts/build-production.mjs. User-installed CAs are NOT trusted: the app does not depend on each device's install step.
     Requests go through CapacitorHttp (native), which applies this config. Shared by productionDebug (the throwaway / dev test CA)
     and productionRelease (build.gradle sourceSets).
     A10-04 (audit 26 Oct 2026): no domain-config or pins, because the server address is typed on the tablet at run time. The system
     CAs stay for a hotel that buys a public certificate instead; for the planned install (hotel CA, DEC-087 / D10, server addressed by
     a LAN IP or an internal name) a public CA cannot issue a certificate for that address. The hotel CA itself is name-constrained
     to the server's names / addresses and its key is kept off the PC (New-HccCertificate.ps1, S3). When the owner confirms "hotel CA
     only", delete the system line below. scripts/build-production.mjs (checkNetworkConfig) refuses user CAs, any other bundled CA, pin
     overrides and cleartext. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/hcc_hotel_ca" />
        </trust-anchors>
    </base-config>
</network-security-config>
