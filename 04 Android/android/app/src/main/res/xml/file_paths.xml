<?xml version="1.0" encoding="utf-8"?>
<!-- Security review F-L10 / audit A10-01: the FileProvider shares only the app's private export folder (cache/exports, written by
     saveTextFile / saveBinaryFile in 03 Prototype/src/app/native.ts and deleted on sign-out by clearExports) — not the whole cache,
     and nothing in public storage (the old Documents/HCC folder is no longer used).
     Wave B1 (DEC-073): the bank-deposit slip photo is taken with <input type="file" accept="image/*" capture="environment">. Capacitor 8's
     BridgeWebChromeClient (createImageFile) writes the camera's photo to getExternalFilesDir(DIRECTORY_PICTURES) = Android/data/<app>/files/Pictures
     and passes it to the camera app through this FileProvider, so that ONE app-specific folder is shared as well (not public storage, not the
     whole files dir). The app compresses the photo, sends it, and deletes the folder (clearCapturedPhotos in native.ts). -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="hcc_exports" path="exports/" />
    <external-files-path name="hcc_slip_capture" path="Pictures/" />
</paths>
