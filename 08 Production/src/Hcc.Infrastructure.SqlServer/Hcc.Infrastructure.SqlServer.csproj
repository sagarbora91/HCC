<Project Sdk="Microsoft.NET.Sdk">
  <!-- SQL Server adapter: connection policy, migrations (+ backup gate), command transactions, idempotency, outbox, audit. -->
  <PropertyGroup>
    <RootNamespace>Hcc.Infrastructure.SqlServer</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Hcc.Application\Hcc.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>
  <ItemGroup>
    <!-- Migrations are embedded so the runner never depends on the working directory. -->
    <EmbeddedResource Include="..\..\database\migrations\*.sql" LogicalName="Hcc.Migrations.%(Filename)%(Extension)" />
    <!-- P1 access migrations (block 0100-0199), loaded by Access/AccessMigrationSource until the runner accepts numbered blocks. -->
    <EmbeddedResource Include="..\..\database\migrations\access\*.sql" LogicalName="Hcc.AccessMigrations.%(Filename)%(Extension)" />
    <!-- Wave 1 module migrations (block-numbered, e.g. P4 0400-0499), applied by Billing/ModuleMigrationSource until the runner accepts blocks. -->
    <EmbeddedResource Include="..\..\database\modules\*.sql" LogicalName="Hcc.ModuleMigrations.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
