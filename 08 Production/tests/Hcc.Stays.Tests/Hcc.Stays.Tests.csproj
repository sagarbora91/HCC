<Project Sdk="Microsoft.NET.Sdk">
  <!-- P3 stays + housekeeping tests: kernel/golden (no database) and SQL integration on disposable HccTest_* databases. -->
  <PropertyGroup>
    <RootNamespace>Hcc.Stays.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Hcc.Api\Hcc.Api.csproj" />
    <ProjectReference Include="..\..\src\Hcc.Infrastructure.SqlServer\Hcc.Infrastructure.SqlServer.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- P3 module migrations (database/modules/03xx) until the frozen runner accepts module blocks in database/migrations. -->
    <EmbeddedResource Include="..\..\database\modules\03*.sql" LogicalName="Hcc.P3Migrations.%(Filename)%(Extension)" />
    <None Include="Golden\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
