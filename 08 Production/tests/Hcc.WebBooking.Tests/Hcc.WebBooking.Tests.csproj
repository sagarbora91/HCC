<Project Sdk="Microsoft.NET.Sdk">
  <!-- W3-2 booking website tests: rules (no database), SQL integration and public HTTP on disposable HccTest_* databases. -->
  <PropertyGroup>
    <RootNamespace>Hcc.WebBooking.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Hcc.Api\Hcc.Api.csproj" />
    <ProjectReference Include="..\..\src\Hcc.Infrastructure.SqlServer\Hcc.Infrastructure.SqlServer.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- DEC-085: the shipped settings sample and the install guide are read by BookingWebsiteOffAtGoLiveTests. -->
    <None Include="..\..\deployment\windows\appsettings.Production.sample.json" Link="Deployment\appsettings.Production.sample.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\deployment\windows\INSTALL.md" Link="Deployment\INSTALL.md" CopyToOutputDirectory="PreserveNewest" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
