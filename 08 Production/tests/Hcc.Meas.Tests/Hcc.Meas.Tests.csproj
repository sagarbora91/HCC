<Project Sdk="Microsoft.NET.Sdk">
  <!-- F12 MEAS tests (MEAS-CONTRACT §10): meas-settings creates the project; later lanes add test files, not projects.
       MeasurementGate three-level rule, MEAS_OFF refusal, route metadata, TypeScript key table = C# MeasurementCatalogue (parity). -->
  <PropertyGroup>
    <RootNamespace>Hcc.Meas.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Hcc.Api\Hcc.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- f12-int-cap: the SQL round trip (Capture/MeasCaptureSqlTests.cs) uses the Hcc.Inventory.Tests database harness, as Hcc.Yield.Tests does. -->
    <Compile Include="..\Hcc.Inventory.Tests\Harness\GoldenInventory.cs" Link="Linked\GoldenInventory.cs" />
    <Compile Include="..\Hcc.Inventory.Tests\Harness\InventoryDatabase.cs" Link="Linked\InventoryDatabase.cs" />
    <Compile Include="..\Hcc.Inventory.Tests\Harness\TestSessions.cs" Link="Linked\TestSessions.cs" />
    <None Include="..\Hcc.Inventory.Tests\Golden\inventory-base.golden.json" Link="Golden\inventory-base.golden.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
