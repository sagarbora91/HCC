<Project Sdk="Microsoft.NET.Sdk">
  <!-- P2 inventory & reservations tests: domain rules, golden prototype figures on SQL, lifecycle, concurrency, HTTP smoke. -->
  <PropertyGroup>
    <RootNamespace>Hcc.Inventory.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Hcc.Api\Hcc.Api.csproj" />
    <ProjectReference Include="..\..\src\Hcc.Infrastructure.SqlServer\Hcc.Infrastructure.SqlServer.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Golden\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
