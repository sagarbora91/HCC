<Project Sdk="Microsoft.NET.Sdk">
  <!-- F7-R1 report engine tests: catalogue cross-check with the prototype (catalogue.json), parameter binding, rule V / M, masks, OP-13 hook,
       three-way renderer equality (screen = Excel = PDF text / print), PDF golden (text + page count), schedules; SQL stores on HccTest_*. -->
  <PropertyGroup>
    <RootNamespace>Hcc.Reporting.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Hcc.Reporting\Hcc.Reporting.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="catalogue.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Goldens\*.*" CopyToOutputDirectory="PreserveNewest" LinkBase="Goldens" />
    <!-- F12-STUDY-A -->
    <None Include="MeasStudyA\*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="MeasStudyA" />
    <!-- F12-STUDY-A end -->
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
