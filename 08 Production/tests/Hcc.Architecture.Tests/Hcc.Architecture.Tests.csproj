<Project Sdk="Microsoft.NET.Sdk">
  <!-- F5-E1 architecture rules (EGRESS-CONTRACT §2): no outbound network API outside Hcc.Infrastructure.Egress; one "egress" client, gate first.
       Source scan only (no database, no references to the production assemblies). -->
  <PropertyGroup>
    <RootNamespace>Hcc.Architecture.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
