<Project Sdk="Microsoft.NET.Sdk">
  <!-- A04 audit probe: runs the SERVER payroll kernel (prebuilt Hcc.Domain / Hcc.Application DLLs from 08 Production, read-only)
       on the scenarios written by ../A04_recompute.mjs. Build with -p:HccBin=<08 Production/src/Hcc.Application/bin/Debug/net10.0/>
       and -o / BaseIntermediateOutputPath in a scratch folder so nothing lands in the repo. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Hcc.Contracts"><HintPath>$(HccBin)Hcc.Contracts.dll</HintPath></Reference>
    <Reference Include="Hcc.Domain"><HintPath>$(HccBin)Hcc.Domain.dll</HintPath></Reference>
    <Reference Include="Hcc.Application"><HintPath>$(HccBin)Hcc.Application.dll</HintPath></Reference>
  </ItemGroup>
</Project>
