<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.5005.3"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT r.room_id, r.room_no, t.code, r.hk_status, r.row_ver,&#xa;       b.block_id, b.room_id, b.from_date, b.to_date, b.reason, b.source, b.row_ver,&#xa;       cur.guest_name, cur.arrival, cur.departure,&#xa;       nxt.guest_name, nxt.arrival, nxt.departure&#xa;FROM inv.room r&#xa;JOIN inv.room_type t ON t.room_type_id = r.room_type_id&#xa;LEFT JOIN ops.room_block b ON b.room_id = r.room_id AND b.released_utc IS NULL&#xa;OUTER APPLY (SELECT TOP (1) res.guest_name, s.arrival, s.departure&#xa;             FROM gst.stay_segment seg JOIN gst.stay s ON s.stay_id = seg.stay_id JOIN inv.reservation res ON res.reservation_id = s.reservation_id&#xa;             WHERE seg.room_id = r.room_id AND seg.to_date IS NULL) cur&#xa;OUTER APPLY (SELECT TOP (1) res.guest_name, res.arrival, res.departure&#xa;             FROM inv.reservation res&#xa;             WHERE res.status = &apos;Confirmed&apos; AND EXISTS (SELECT 1 FROM inv.room_night n WHERE n.reservation_id = res.reservation_id AND n.room_id = r.room_id)&#xa;             ORDER BY res.arrival, res.reservation_id) nxt&#xa;WHERE r.property_id = @p&#xa;ORDER BY r.room_no" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x0900EA1F160B7BB8BF2A591E01286931A0970000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="1" RetrievedFromCache="true" StatementSubTreeCost="0.224194" StatementEstRows="24" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x01AC5D0C092B23CD" QueryPlanHash="0xB09C8106CFC042EA" StatementOptmEarlyAbortReason="GoodEnoughPlanFound" CardinalityEstimationModelVersion="170"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="0" NonParallelPlanReason="NoParallelPlansInDesktopOrExpressEdition" CachedPlanSize="120" CompileTime="22" CompileCPU="20" CompileMemory="2072"><MemoryGrantInfo SerialRequiredMemory="0" SerialDesiredMemory="0" GrantedMemory="0" MaxUsedMemory="0"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="415552" EstimatedPagesCached="207776" EstimatedAvailableDegreeOfParallelism="4" MaxCompileMemory="4750496"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-10-26T22:21:48.37" ModificationCount="0" SamplingPercent="100" Statistics="[PK_room_type]" Table="[room_type]" Schema="[inv]" Database="[HccTest_PERF_20261026163525]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-26T22:23:55.96" ModificationCount="0" SamplingPercent="100" Statistics="[IX_reservation_confirmed]" Table="[reservation]" Schema="[inv]" Database="[HccTest_PERF_20261026163525]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-26T22:19:58.77" ModificationCount="90" SamplingPercent="100" Statistics="[PK_stay]" Table="[stay]" Schema="[gst]" Database="[HccTest_PERF_20261026163525]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-26T22:05:33.05" ModificationCount="0" SamplingPercent="100" Statistics="[UQ_room]" Table="[room]" Schema="[inv]" Database="[HccTest_PERF_20261026163525]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-26T22:05:34.31" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_00000004_76969D2E]" Table="[room]" Schema="[inv]" Database="[HccTest_PERF_20261026163525]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-26T22:21:48.46" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_00000007_7D439ABD]" Table="[reservation]" Schema="[inv]" Database="[HccTest_PERF_20261026163525]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-26T22:12:23.59" ModificationCount="699" SamplingPercent="100"