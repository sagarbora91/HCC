<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.5005.3"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT r.room_id, r.room_no, t.code, r.hk_status, r.row_ver,&#xa;               b.block_id, b.room_id, b.from_date, b.to_date, b.reason, b.source, b.row_ver,&#xa;               cur.guest_name, cur.arrival, cur.departure,&#xa;               nxt.guest_name, nxt.arrival, nxt.departure&#xa;        FROM inv.room r&#xa;        JOIN inv.room_type t ON t.room_type_id = r.room_type_id&#xa;        LEFT JOIN ops.room_block b ON b.room_id = r.room_id AND b.released_utc IS NULL&#xa;        LEFT JOIN (SELECT seg.room_id, res.guest_name, s.arrival, s.departure&#xa;                   FROM gst.stay_segment seg JOIN gst.stay s ON s.stay_id = seg.stay_id JOIN inv.reservation res ON res.reservation_id = s.reservation_id&#xa;                   WHERE seg.to_date IS NULL) cur ON cur.room_id = r.room_id&#xa;        LEFT JOIN (SELECT x.room_id, x.guest_name, x.arrival, x.departure&#xa;                   FROM (SELECT night.room_id, res.guest_name, res.arrival, res.departure,&#xa;                                ROW_NUMBER() OVER (PARTITION BY night.room_id ORDER BY res.arrival, res.reservation_id) AS pick&#xa;                         FROM inv.reservation res&#xa;                         CROSS APPLY (SELECT DISTINCT n.room_id FROM inv.room_night n WHERE n.reservation_id = res.reservation_id) night&#xa;                         WHERE res.status = &apos;Confirmed&apos;) x&#xa;                   WHERE x.pick = 1) nxt ON nxt.room_id = r.room_id&#xa;        WHERE r.property_id = @p&#xa;        ORDER BY r.room_no" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x090006AB11E3504F456B322AEF1B29185DB30000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="1" RetrievedFromCache="true" StatementSubTreeCost="0.241002" StatementEstRows="12.9637" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x306BB528031B507E" QueryPlanHash="0xBAE20C8BDCF72CD4" StatementOptmEarlyAbortReason="TimeOut" CardinalityEstimationModelVersion="170"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="0" MemoryGrant="2112" NonParallelPlanReason="NoParallelPlansInDesktopOrExpressEdition" CachedPlanSize="144" CompileTime="16" CompileCPU="16" CompileMemory="1944"><MemoryGrantInfo SerialRequiredMemory="1536" SerialDesiredMemory="2112" RequiredMemory="1536" DesiredMemory="2112" RequestedMemory="2112" GrantWaitTime="0" MaxQueryMemory="1150456" GrantedMemory="2112" MaxUsedMemory="688"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="415552" EstimatedPagesCached="207776" EstimatedAvailableDegreeOfParallelism="4" MaxCompileMemory="4739776"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-10-26T22:21:48.37" ModificationCount="0" SamplingPercent="100" Statistics="[PK_room_type]" Table="[room_type]" Schema="[inv]" Database="[HccTest_PERF_20261026163525]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-26T22:24:10.49" ModificationCount="0" SamplingPercent="100" Statistics="[IX_reservation_confirmed]" Table="[reservation]" Schema="[inv]" Database="[HccTest_PERF_20261026163525]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-26T22:19:58.77" ModificationCount="90" SamplingPercent="100" Statistics="[PK_stay]" Table="[stay]" Schema="[gst]" Database="[HccTest_PERF_20261026163525]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-26T22:05:33.05" ModificationCount="0" SamplingPercent="100" Statistics="[UQ_room]" Table="[room]" Schema="[inv]" Database="[HccTest_PERF_20261026163525]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-26T22:0