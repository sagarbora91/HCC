   "id": 0,
   "title": "The phone shell: app bar, tabs and menu",
   "goal": "Find your way on the phone: Modules cards, the app bar, the bottom tabs, the menu and search.",
   "user": "Aarav (Reception)",
   "uid": "reception",
   "menu": "Modules",
   "display": "mobile",
   "steps": [
    {
     "id": "0.1",
     "say": "This is Modules on the phone. The modules are cards instead of a grid, and the red number on a card is the work waiting there.",
     "why": "The phone shows the same modules as the PC, laid out for one thumb.",
     "form": "",
     "menu": "",
     "key": "",
     "target": "sel:.tiles",
     "action": "read",
     "value": "",
     "expect": "The module cards for Aarav.",
     "check": "has('Welcome, Aarav')",
     "auto": [],
     "shot": "00_01.png",
     "msg": null,
     "msgText": null,
     "msgwhy": "",
     "hint_mr": ""
    },
    {
     "id": "0.2",
     "say": "The red bar at the top shows the page title, the business date with Open, a search icon and your initial. The page title changes as you move.",
     "why": "The date and the name tell you whose work and which day you are in.",
     "form": "",
     "menu": "",
     "key": "",
     "target": "sel:header",
     "action": "read",
     "value": "",
     "expect": "The app bar with the date 24 Oct.",
     "check": "",
     "auto": [],
