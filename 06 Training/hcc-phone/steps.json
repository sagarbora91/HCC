     "say": "The tabs at the bottom are Rooms, Arrivals, Bookings, Folios and Menu. They are always there, so one tap takes you to the five most used screens.",
     "why": "A receptionist on the floor needs the board, the arrivals and the folios without opening menus.",
     "form": "",
     "menu": "",
     "key": "",
     "target": "btn:Rooms",
     "action": "read",
     "value": "",
     "expect": "The five tabs.",
