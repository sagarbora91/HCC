{
 "_regex_note": "f12-int 7 Nov 2026: regexes aligned with the built reports (billed = total billed incl. GST vs Year Comparison Summary, because the Monthly Revenue FY Summary holds formulas without cached values; ADR sheet KPI by FY; bad debt Due; zero-rate Zero rate; repeat Repeat %). No figure changed.",
 "_about": "F12 MEAS legacy golden (tools/meas-legacy-golden.ps1). One entry per headline metric: where the ported HCC report holds it (report id, section title regex, column label regex) and where the legacy workbook holds it (file, sheet, column header regex on the header row whose first cell is FY). kind: money (HCC paise, workbook rupees), nights, pct (HCC points, workbook fraction), count. Tolerances: money 0.1 %, nights 5, pct 0.5 points, count 0. The integrator adjusts a regex if a lane's column label differs; never the figures.",
 "tolerance": {"money": 0.001, "nights": 5, "pct": 0.5, "count": 0},
 "metrics": [
  {"metric": "billed", "kind": "money", "hcc": {"report": "rpt.study.revenue-monthly", "section": "^FY summary", "column": "^Total billed"}, "workbook": {"file": "HCC_Year_Comparison_Report.xlsx", "sheet": "Summary", "column": "^Total billed"}},
  {"metric": "roomNights", "kind": "nights", "hcc": {"report": "rpt.study.occupancy-history", "section": "FY summary", "column": "^Room-nights sold"}, "workbook": {"file": "HCC_Occupancy_Report.xlsx", "sheet": "FY summary", "column": "^Room-nights sold"}},
  {"metric": "occupancy", "kind": "pct", "hcc": {"report": "rpt.study.occupancy-history", "section": "FY summary", "column": "OCCUPANCY|^Occupancy %"}, "workbook": {"file": "HCC_Occupancy_Report.xlsx", "sheet": "FY summary", "column": "^OCCUPANCY %"}},
  {"metric": "adr", "kind": "money", "hcc": {"report": "rpt.study.revenue-kpi", "section": "FY", "column": "^ADR"}, "workbook": {"file": "HCC_Revenue_Management_Report.xlsx", "sheet": "KPI by FY", "column": "^ADR"}},
  {"metric": "badDebt", "kind": "money", "hcc": {"report": "rpt.study.receivables-bad-debt", "section": "Bad Debt Schedule", "column": "^Due$"}, "workbook": {"file": "HCC_Receivables_Report.xlsx", "sheet": "Bad Debt Schedule", "column": "^Reconciled amount"}},
  {"metric": "zeroRate", "kind": "count", "hcc": {"report": "rpt.study.zero-rate-complimentary", "section": "^Zero by FY and category", "column": "^Zero rate$"}, "workbook": {"file": "HCC_ZeroRate_Complimentary_Report.xlsx", "sheet": "Rate Changes by FY", "column": "^Set to zero"}},
  {"metric": "repeatPct", "kind": "pct", "hcc": {"report": "rpt.study.guest-repeat-value", "section": "Repeat Guests by FY", "column": "^Repeat %"}, "workbook": {"file": "HCC_Guest_Report.xlsx", "sheet": "Repeat Guests by FY", "column": "^Repeat customer %"}},
  {"metric": "hallEvents", "kind": "count", "hcc": {"report": "rpt.study.fnb-halls-ancillary", "section": "Hall Utilisation", "column": "events|bookings"}, "workbook": {"file": "HCC_FnB_Halls_Ancillary_Report.xlsx", "sheet": "Hall Utilisation", "column": "events|bookings"}}
 ],
 "dryMetrics": [
  {"metric": "roomNights", "kind": "nights", "hcc": {"report": "rpt.study.management-pack", "section": "^Executive summary", "column": "^Room-nights slept"}},
  {"metric": "chargedNights", "kind": "nights", "hcc": {"report": "rpt.study.management-pack", "section": "^Executive summary", "column": "^Charged nights"}},
  {"metric": "roomRevenue", "kind": "money", "hcc": {"report": "rpt.study.management-pack", "section": "^Executive summary", "column": "^Room revenue"}},
  {"metric": "occupancy", "kind": "pct", "hcc": {"report": "rpt.study.management-pack", "section": "^Executive summary", "column": "^Occupancy %"}},
  {"metric": "adr", "kind": "money", "hcc": {"report": "rpt.study.management-pack", "section": "^Executive summary", "column": "^ADR"}}
 ]
